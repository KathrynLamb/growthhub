# .env.example  (copy to .env and fill in; never commit .env)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=stories.flipwhizz.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://stories.flipwhizz.com,https://flipwhizz.com
# Phase 2 only (served via flipwhizz.com/stories): STATIC_URL=/stories/static/ and PUBLIC_BASE_URL=https://flipwhizz.com
STATIC_URL=/static/
PUBLIC_BASE_URL=

# MySQL (use DB_ENGINE=sqlite for a quick local run with no database server)
DB_ENGINE=mysql
DB_NAME=growthhub
DB_USER=growthhub
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Integrations (leave blank in development: offline story + no email)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
RESEND_API_KEY=
RESEND_FROM=FlipWhizz <hello@flipwhizz.com>
FLIPWHIZZ_URL=https://flipwhizz.com

# Limits
PRINTABLE_LIMIT_PER_EMAIL_PER_DAY=3
PRINTABLE_LIMIT_PER_IP_PER_DAY=5
PRINTABLE_GLOBAL_LIMIT_PER_DAY=200
PRINTABLE_MAX_ATTEMPTS=3
PRINTABLE_RETENTION_DAYS=30
IP_HASH_SALT=change-me-too
